{
  "name": "dsh-market-info",
  "version": "1.10.2",
  "private": true,
  "description": "市场资讯：49 源 / 20 类别 / 7 域；交易所回购资金利率、中美国债曲线、外汇、期权 PCR、期货、公司行动、披露、宏观、地缘气候；T0-T3 实测节奏调度；60 天回填时间序列；总览两栏看板；公司档案含五类公司行动与相关新闻",
  "license": "MIT",
  "author": "YansongG-HKU",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "ui",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YansongG-HKU/dsh-market-info.git"
  },
  "homepage": "https://github.com/YansongG-HKU/dsh-market-info#readme",
  "bugs": {
    "url": "https://github.com/YansongG-HKU/dsh-market-info/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "market",
    "market-data",
    "quotes",
    "news",
    "tradingview",
    "reader"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  }
}
